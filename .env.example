# Required in production
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Staff bootstrap (set at least one of ADMIN_PASSWORD or ADMIN_PASSWORD_HASH)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=use-a-strong-unique-password
# ADMIN_PASSWORD_HASH=pbkdf2:sha256:...

# HTTPS deployments
SECURE_COOKIES=false

# development | production
FLASK_ENV=development

# Only for local demos without ADMIN_PASSWORD (never enable in production)
# ALLOW_DEFAULT_ADMIN=true

# Free Web Push (browser notifications by tracking number)
# Generate keys: python -c "from py_vapid import Vapid01; v=Vapid01(); v.generate_keys(); print(v.public_key); print(v.private_key)"
# Or: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@yourbarangay.gov.ph

# Public site URL (required for correct push deep-links in production)
PUBLIC_BASE_URL=https://your-domain.example

# Android FCM (Firebase) — when building the Android Studio app
# FIREBASE_CREDENTIALS_JSON=/path/to/firebase-adminsdk.json
# FCM_SERVER_KEY=   # legacy alternative; prefer service account JSON
